# Copy to .env and fill in. Never commit .env.

# --- server ---
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8000

# --- Authentication ---
SESSION_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Todoist Clone"

# --- SQLite ---
DATABASE_PATH=./data/todoist.db

# --- Web Push (optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Automatic backups ---
BACKUP_INTERVAL_MINUTES=60
BACKUP_KEEP=24

# --- Quiet hours (optional, HH:MM) ---
QUIET_HOURS_START=
QUIET_HOURS_END=
