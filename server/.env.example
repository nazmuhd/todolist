# Copy to .env and fill in. Never commit .env.

# --- server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:8000

# --- SQLite ---
# Relative paths are resolved from the server/ directory. `:memory:` is useful
# for tests. The file and its -wal/-shm siblings are created on first boot.
DATABASE_PATH=./data/todoist.db

# --- Web Push (optional, generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
