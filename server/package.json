{
  "name": "todoist-clone-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node --watch --watch-path=./src --experimental-strip-types src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "migrate": "node --experimental-strip-types src/db/migrate.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "resend": "^6.38.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.10.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.11"
  }
}
