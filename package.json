{
  "name": "todoist-clone",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "pnpm --filter todoist-clone-server dev",
    "build": "pnpm --filter todoist-clone-frontend build",
    "start": "pnpm --filter todoist-clone-server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "migrate": "pnpm --filter todoist-clone-server migrate"
  }
}
